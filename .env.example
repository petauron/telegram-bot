# Pin the image digest from the GitHub release.
TELEGRAM_BOT_IMAGE=
COLLECTOR_ENABLED=false
TG_API_ID=
TG_API_HASH=
TG_PHONE=
TG_SESSION_PATH=/session/telegram
# 首次启动时引导到 SQLite；之后可在 Web“推送渠道”中修改或停用
PUSH_BOT_TOKEN=
PUSH_CHAT_ID=
WATCH_CHAT_IDS=-1001234567890,-1009876543210
TRUSTED_SENDER_IDS=
# 仅作为本地审计规则和已通过外部资讯分类后的兴趣线索，不能单独取得推送资格
IMPORTANT_KEYWORDS=宕机,服务中断,停服,被墙,故障,维护,服务异常,服务恢复,漏洞,CVE,零日,0day,数据泄露,供应链攻击,安全事件,重大更新,版本发布,正式发布,开源,涨价,价格调整,退款政策,政策变更,封禁政策,新规,制裁
DATABASE_PATH=/database/messages.db
RETENTION_DAYS=3
# 跨群并行分析 worker；同一群仍严格串行
ANALYSIS_WORKERS=8
ANALYSIS_BATCH_TARGET=20
ANALYSIS_BATCH_MAX_ITEMS=50
ANALYSIS_BATCH_MAX_CHARS=12000
ANALYSIS_BATCH_MAX_WAIT_SECONDS=2
WEB_USERNAME=admin
# Web 管理密码至少 8 个字符，且不能保留下面的示例值
WEB_PASSWORD=change-this-to-a-long-random-password
WEB_COOKIE_SECURE=false
WEB_PORT=8080
